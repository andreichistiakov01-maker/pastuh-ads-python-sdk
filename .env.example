# Pastuh Ads Partner API — пример конфигурации.
# Скопируйте в .env и заполните своими значениями.

# Базовый URL Partner API (с префиксом /api/partner/v1).
PASTUH_ADS_API_URL=https://pastuhads.com/api/partner/v1

# API-ключ партнёра. Выдаётся в кабинете Pastuh Ads один раз,
# формат: opk_<40 строчных буквено-цифровых символов>.
PASTUH_ADS_API_KEY=opk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID источника — целое число. Кабинет → страница источника →
# поле «API Source ID». Важно: НЕ публичный идентификатор src_48,
# а просто число (например 48).
PASTUH_ADS_SOURCE_ID=50

# ID плейсмента — целое число. Страница источника → «Placement ID»,
# или раздел «Плейсменты» в кабинете. Также доступен через
# GET /placements — если не задать, basic_usage.py найдёт сам.
PASTUH_ADS_PLACEMENT_ID=1

# --- Только для examples/aiogram3_bot.py ---
# Токен вашего Telegram-бота от @BotFather.
BOT_TOKEN=123456:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Username вашего бота без @ — нужен только если бот сам
# является рекламируемым ресурсом (server_callback mode).
BOT_USERNAME=your_bot

# --- Только для examples/basic_usage.py ---
# Telegram ID тестового пользователя для op-list.
PASTUH_ADS_TEST_TG_USER_ID=123456789
